{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEAD AIR",
  "version": "0.3.2",
  "identifier": "io.deadair.workstation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "incognito": true, "title": "DEAD//AIR — Wireless Workstation", "width": 1440, "height": 960, "minWidth": 900, "minHeight": 640, "backgroundColor": "#050907" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "category": "Utility",
    "shortDescription": "Passive wireless diagnostics workstation",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "pkexec"], "files": { "/usr/libexec/deadair-capture-helper": "../packaging/bin/deadair-capture-helper", "/usr/share/polkit-1/actions/io.deadair.capture.policy": "../packaging/io.deadair.capture.policy" } },
      "rpm": { "depends": ["webkit2gtk4.1", "polkit"], "files": { "/usr/libexec/deadair-capture-helper": "../packaging/bin/deadair-capture-helper", "/usr/share/polkit-1/actions/io.deadair.capture.policy": "../packaging/io.deadair.capture.policy" } }
    }
  }
}
